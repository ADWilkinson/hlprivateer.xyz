# HL Privateer v3 operator environment
#
# v3 is one trading runtime (`apps/agent`) plus the public Next.js site.
# There is no Redis bus, database, WebSocket gateway, JWT login service, x402
# entitlement service, or internal multi-role runner in the active system.

# Agent runtime
NODE_ENV=development
TZ=UTC
AGENT_HTTP_PORT=4100
AGENT_INTERVAL_MS=30000
AGENT_AUDIT_PATH=data/audit.jsonl

# Hyperliquid accountancy
AGENT_HL_USER=0xYourWalletAddress
AGENT_HL_TESTNET=0
AGENT_HL_INFO_URL=
AGENT_HL_TTL_MS=4000

# Strategy seam
# Command must read the rendered prompt from stdin and write the model response
# to stdout. Examples: `claude -p`, `codex`, or an operator wrapper script.
AGENT_LLM_COMMAND="claude -p"

# Operator controls
# Required for POST /v1/operator/halt and /v1/operator/resume.
# When unset, operator routes return 401.
AGENT_OPERATOR_TOKEN=

# Optional public-floor baseline
# If set, /v1/public/floor returns pnlPct = (equity - baseline) / baseline.
AGENT_PNL_BASELINE_USD=

# Optional source fixture for local/manual signal ingestion.
AGENT_FIXTURE=

# Operator-owned wiring/config paths
AGENT_WIRING=apps/agent/wiring.ts
STRATEGY_CONFIG_PATH=config/strategy.json

# Web build/runtime
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4100
