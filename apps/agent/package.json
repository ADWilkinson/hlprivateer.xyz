{
  "name": "@hl/privateer-agent",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "bunx tsx watch src/main.ts",
    "build": "bunx tsc -p tsconfig.json",
